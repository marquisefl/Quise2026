---
/**
 * Project Card Component
 *
 * Displays a case study preview in a grid.
 * Features hover effects and subtle animation.
 */

interface Props {
  slug: string;
  title: string;
  company: string;
  thumbnail: string;
  tags?: string[];
  index?: number;
}

const { slug, title, company, thumbnail, tags = [], index = 0 } = Astro.props;
---

<article class="project-card" style={`--delay: ${index * 100}ms`}>
  <a href={`/work/${slug}`} class="project-link" aria-label={`View ${title} case study`}>
    <div class="project-image">
      <div class="image-wrapper">
        <!-- TODO: Replace with actual project images -->
        <div class="placeholder-image" aria-hidden="true">
          <span class="placeholder-text">{title.charAt(0)}</span>
        </div>
      </div>
      <div class="overlay"></div>
    </div>

    <div class="project-info">
      <div class="project-meta">
        <span class="project-company">{company}</span>
        {tags.length > 0 && (
          <div class="project-tags">
            {tags.slice(0, 2).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      <h3 class="project-title">{title}</h3>
      <span class="view-project">
        View Project
        <span class="arrow">&rarr;</span>
      </span>
    </div>
  </a>
</article>

<style>
  .project-card {
    opacity: 0;
    animation: fadeInUp var(--transition-slow) ease forwards;
    animation-delay: var(--delay);
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-link:hover {
    opacity: 1;
  }

  .project-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-gray-100);
    margin-bottom: var(--space-6);
  }

  .image-wrapper {
    width: 100%;
    height: 100%;
    transition: transform var(--transition-slow);
  }

  .project-link:hover .image-wrapper {
    transform: scale(1.05);
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-gray-100);
  }

  .placeholder-text {
    font-size: var(--text-6xl);
    font-weight: var(--font-light);
    color: var(--color-gray-300);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-black);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .project-link:hover .overlay {
    opacity: 0.1;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-company {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-gray-400);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
    transition: opacity var(--transition-fast);
  }

  .project-link:hover .project-title {
    opacity: 0.7;
  }

  .view-project {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-gray-500);
    margin-top: var(--space-2);
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .project-link:hover .view-project {
    color: var(--color-black);
    gap: var(--space-3);
  }

  .arrow {
    transition: transform var(--transition-fast);
  }

  .project-link:hover .arrow {
    transform: translateX(4px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
