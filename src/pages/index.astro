---
/**
 * Home Page
 *
 * Landing page featuring hero section, selected work, and introduction.
 * Content sourced from site-data.ts.
 *
 * Design: Editorial, confident, minimal with black & white palette.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Button from "../components/Button.astro";
import { siteData } from "../content/site-data";

const title = `${siteData.profile.name} | ${siteData.profile.title}`;
const featuredProjects = siteData.caseStudies.slice(0, 3);
---

<BaseLayout title={title}>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-intro">
          <span class="hero-label animate-fade-in">UI/UX Designer</span>
        </div>

        <h1 class="hero-title animate-fade-in stagger-1">
          {siteData.profile.name}
        </h1>

        <p class="hero-tagline animate-fade-in stagger-2">
          {siteData.profile.tagline}
        </p>

        <div class="hero-cta animate-fade-in stagger-3">
          <Button href="/work" variant="primary" size="lg">
            View Work
          </Button>
          <Button href="/contact" variant="outline" size="lg">
            Get in Touch
          </Button>
        </div>
      </div>

      <div class="hero-scroll animate-fade-in stagger-4">
        <span class="scroll-text">Scroll to explore</span>
        <span class="scroll-arrow">&darr;</span>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section class="selected-work section" id="work">
    <div class="container">
      <SectionHeader
        label="Selected Work"
        title="Recent Projects"
        description="A selection of case studies showcasing my approach to user-centered design."
      />

      <div class="projects-grid">
        {featuredProjects.map((project, index) => (
          <ProjectCard
            slug={project.slug}
            title={project.title}
            company={project.company}
            thumbnail={project.thumbnail}
            tags={project.tags}
            index={index}
          />
        ))}
      </div>

      <div class="view-all">
        <Button href="/work" variant="outline">
          View All Work
          <span>&rarr;</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="introduction section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-content">
          <span class="intro-label">About</span>
          <h2 class="intro-title">
            Creating meaningful digital experiences through user-centered design.
          </h2>
          <!-- TODO: Replace with actual bio content -->
          <p class="intro-text">
            With experience at companies like ABM Industries, Y Media Labs, and Province Brands of Canada,
            I specialize in crafting intuitive interfaces that balance business goals with user needs.
          </p>
          <p class="intro-text">
            My approach combines research-driven insights with clean, purposeful design to create
            products that truly resonate with users.
          </p>
          <Button href="/about" variant="secondary">
            More About Me
            <span>&rarr;</span>
          </Button>
        </div>

        <div class="intro-stats">
          <div class="stat">
            <span class="stat-number">7+</span>
            <span class="stat-label">Companies</span>
          </div>
          <div class="stat">
            <span class="stat-number">UI/UX</span>
            <span class="stat-label">Focus</span>
          </div>
          <div class="stat">
            <span class="stat-number">ATL</span>
            <span class="stat-label">Based</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Let's work together</h2>
        <p class="cta-text">
          Have a project in mind? I'd love to hear about it.
        </p>
        <Button href="/contact" variant="primary" size="lg">
          Start a Conversation
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: var(--space-16);
    position: relative;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-intro {
    margin-bottom: var(--space-6);
  }

  .hero-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
  }

  .hero-title {
    font-size: var(--text-6xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-8);
  }

  .hero-tagline {
    font-size: var(--text-2xl);
    font-weight: var(--font-light);
    color: var(--color-gray-600);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-12);
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-12);
    left: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .hero-scroll {
      left: var(--space-12);
    }
  }

  .scroll-text {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-400);
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .scroll-arrow {
    font-size: var(--text-lg);
    color: var(--color-gray-400);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(10px);
    }
    60% {
      transform: translateY(5px);
    }
  }

  /* Selected Work Section */
  .selected-work {
    background-color: var(--color-gray-50);
  }

  .projects-grid {
    display: grid;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .view-all {
    text-align: center;
  }

  /* Introduction Section */
  .intro-grid {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .intro-grid {
      grid-template-columns: 2fr 1fr;
      align-items: start;
      gap: var(--space-24);
    }
  }

  .intro-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
    margin-bottom: var(--space-6);
  }

  .intro-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-8);
  }

  .intro-text {
    font-size: var(--text-lg);
    color: var(--color-gray-600);
    line-height: var(--leading-relaxed);
  }

  .intro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .intro-stats {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-number {
    font-size: var(--text-4xl);
    font-weight: var(--font-light);
    line-height: var(--leading-none);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  /* CTA Section */
  .cta-section {
    background-color: var(--color-black);
    color: var(--color-white);
    padding: var(--space-32) 0;
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-6);
  }

  .cta-text {
    font-size: var(--text-lg);
    color: var(--color-gray-400);
    margin-bottom: var(--space-10);
  }

  .cta-section :global(.button--primary) {
    background-color: var(--color-white);
    color: var(--color-black);
  }

  .cta-section :global(.button--primary:hover) {
    background-color: var(--color-gray-200);
  }
</style>
