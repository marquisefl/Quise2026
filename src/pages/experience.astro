---
/**
 * Experience/Resume Page
 *
 * Professional resume page with work history, education, and skills.
 * Content verified from LinkedIn and ZoomInfo.
 *
 * NOTE: Dates and descriptions require user input.
 * TODO placeholders indicate where actual content should be added.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { siteData } from "../content/site-data";

const title = "Experience | Marquise Fleming";
const description = "Professional experience and resume of Marquise Fleming, UI/UX Designer.";
---

<BaseLayout title={title} description={description}>
  <section class="experience-page">
    <div class="container">
      <!-- Header -->
      <header class="page-header">
        <span class="page-label animate-fade-in">Resume</span>
        <h1 class="page-title animate-fade-in stagger-1">Experience</h1>
        <p class="page-intro animate-fade-in stagger-2">
          A journey through design roles across technology, consumer products,
          and creative agencies.
        </p>
      </header>

      <div class="experience-grid">
        <!-- Main Content -->
        <div class="main-content">
          <!-- Work History -->
          <section class="experience-section">
            <h2 class="section-title">Work History</h2>

            <div class="timeline">
              {siteData.workHistory.map((job, index) => (
                <article class="timeline-item" style={`--delay: ${index * 100}ms`}>
                  <div class="timeline-marker"></div>
                  <div class="timeline-content">
                    <header class="job-header">
                      <h3 class="job-title">{job.role}</h3>
                      <span class="job-company">{job.company}</span>
                      <span class="job-period">{job.period}</span>
                    </header>
                    <p class="job-description">{job.description}</p>
                    {job.highlights.length > 0 && (
                      <ul class="job-highlights">
                        {job.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Education -->
          <section class="experience-section">
            <h2 class="section-title">Education</h2>

            <div class="education-list">
              {siteData.education.map((edu) => (
                <article class="education-item">
                  <div class="education-content">
                    <h3 class="education-credential">{edu.credential}</h3>
                    <span class="education-institution">{edu.institution}</span>
                    <span class="education-year">{edu.year}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <!-- Skills -->
          <section class="sidebar-section">
            <h2 class="sidebar-title">Skills</h2>

            <div class="skills-group">
              <h3 class="skills-category">Design</h3>
              <ul class="skills-list">
                {siteData.skills.design.map((skill) => (
                  <li class="skill-tag">{skill}</li>
                ))}
              </ul>
            </div>

            <div class="skills-group">
              <h3 class="skills-category">Tools</h3>
              <ul class="skills-list">
                {siteData.skills.tools.map((tool) => (
                  <li class="skill-tag">{tool}</li>
                ))}
              </ul>
            </div>

            {siteData.skills.technical.length > 0 && (
              <div class="skills-group">
                <h3 class="skills-category">Technical</h3>
                <ul class="skills-list">
                  {siteData.skills.technical.map((tech) => (
                    <li class="skill-tag">{tech}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>

          <!-- Contact -->
          <section class="sidebar-section">
            <h2 class="sidebar-title">Connect</h2>
            <div class="sidebar-links">
              {siteData.social.linkedin && (
                <a href={siteData.social.linkedin} class="sidebar-link" target="_blank" rel="noopener noreferrer">
                  LinkedIn &rarr;
                </a>
              )}
              {siteData.social.behance && (
                <a href={siteData.social.behance} class="sidebar-link" target="_blank" rel="noopener noreferrer">
                  Behance &rarr;
                </a>
              )}
              <a href="/contact" class="sidebar-link">
                Contact Me &rarr;
              </a>
            </div>
          </section>

          <!-- Download Resume Placeholder -->
          <section class="sidebar-section">
            <h2 class="sidebar-title">Download</h2>
            <p class="sidebar-note">
              TODO: Add downloadable resume PDF
            </p>
            <Button href="#" variant="outline" size="sm">
              Download PDF
            </Button>
          </section>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .experience-page {
    padding-top: 120px;
    padding-bottom: var(--space-32);
  }

  /* Header */
  .page-header {
    margin-bottom: var(--space-20);
    max-width: 600px;
  }

  .page-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-6);
  }

  .page-intro {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
    line-height: var(--leading-relaxed);
  }

  /* Grid Layout */
  .experience-grid {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .experience-grid {
      grid-template-columns: 1fr 320px;
      gap: var(--space-20);
    }
  }

  /* Section Titles */
  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-600);
  }

  /* Timeline */
  .experience-section {
    margin-bottom: var(--space-20);
  }

  .timeline {
    position: relative;
    padding-left: var(--space-8);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background-color: var(--color-gray-600);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-12);
    opacity: 0;
    animation: fadeInUp var(--transition-slow) ease forwards;
    animation-delay: var(--delay);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-8) - 4px);
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--color-black);
    border: 2px solid var(--color-white);
  }

  .timeline-content {
    padding-left: var(--space-4);
  }

  .job-header {
    margin-bottom: var(--space-4);
  }

  .job-title {
    font-size: var(--text-xl);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-1);
  }

  .job-company {
    display: block;
    font-size: var(--text-base);
    color: var(--color-gray-300);
    margin-bottom: var(--space-1);
  }

  .job-period {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-gray-400);
  }

  .job-description {
    font-size: var(--text-base);
    color: var(--color-gray-300);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .job-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .job-highlights li {
    font-size: var(--text-sm);
    color: var(--color-gray-300);
    padding-left: var(--space-5);
    position: relative;
  }

  .job-highlights li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-gray-400);
  }

  /* Education */
  .education-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .education-item {
    padding: var(--space-6);
    background-color: var(--color-gray-800);
  }

  .education-credential {
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-2);
  }

  .education-institution {
    display: block;
    font-size: var(--text-base);
    color: var(--color-gray-300);
    margin-bottom: var(--space-1);
  }

  .education-year {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-gray-400);
  }

  /* Sidebar */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 100px;
    }
  }

  .sidebar-section {
    padding: var(--space-6);
    background-color: var(--color-gray-800);
  }

  .sidebar-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
    margin-bottom: var(--space-6);
  }

  /* Skills */
  .skills-group {
    margin-bottom: var(--space-6);
  }

  .skills-group:last-child {
    margin-bottom: 0;
  }

  .skills-category {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-3);
  }

  .skills-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-gray-600);
    color: var(--color-gray-200);
  }

  /* Sidebar Links */
  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-link {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: opacity var(--transition-fast);
  }

  .sidebar-note {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
