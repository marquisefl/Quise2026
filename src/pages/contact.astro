---
/**
 * Contact Page
 *
 * Contact information and form for professional inquiries.
 *
 * NOTE: Email address requires user input.
 * TODO placeholders indicate where actual content should be added.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../content/site-data";

const title = "Contact | Marquise Fleming";
const description = "Get in touch with Marquise Fleming for design collaboration and opportunities.";
---

<BaseLayout title={title} description={description}>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <!-- Main Content -->
        <div class="contact-main">
          <header class="page-header">
            <span class="page-label animate-fade-in">Contact</span>
            <h1 class="page-title animate-fade-in stagger-1">
              Let's create<br />
              something together.
            </h1>
            <p class="page-intro animate-fade-in stagger-2">
              Have a project in mind or want to discuss a potential collaboration?
              I'd love to hear from you.
            </p>
          </header>

          <!-- Contact Form -->
          <form class="contact-form animate-fade-in stagger-3" action="#" method="POST">
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                required
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                required
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="company" class="form-label">Company <span class="optional">(optional)</span></label>
              <input
                type="text"
                id="company"
                name="company"
                class="form-input"
                autocomplete="organization"
              />
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea
                id="message"
                name="message"
                class="form-textarea"
                rows="6"
                required
              ></textarea>
            </div>

            <button type="submit" class="form-submit">
              Send Message
              <span class="arrow">&rarr;</span>
            </button>

            <p class="form-note">
              TODO: Connect form to email service (Formspree, Netlify Forms, etc.)
            </p>
          </form>
        </div>

        <!-- Sidebar -->
        <aside class="contact-sidebar">
          <div class="sidebar-section">
            <h2 class="sidebar-title">Direct Contact</h2>
            <div class="contact-method">
              <span class="method-label">Email</span>
              <a href={`mailto:${siteData.social.email}`} class="method-value">
                {siteData.social.email}
              </a>
            </div>
            <p class="method-note">TODO: Update with actual email address</p>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Social</h2>
            <div class="social-links">
              {siteData.social.linkedin && (
                <a
                  href={siteData.social.linkedin}
                  class="social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="social-icon">in</span>
                  <span class="social-name">LinkedIn</span>
                </a>
              )}
              {siteData.social.behance && (
                <a
                  href={siteData.social.behance}
                  class="social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="social-icon">Be</span>
                  <span class="social-name">Behance</span>
                </a>
              )}
            </div>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Location</h2>
            <p class="location-text">{siteData.profile.location}</p>
          </div>

          <div class="sidebar-section availability">
            <h2 class="sidebar-title">Availability</h2>
            <p class="availability-text">
              Currently employed at {siteData.profile.currentCompany}.
              Open to freelance projects and consulting.
            </p>
            <p class="availability-note">
              TODO: Update availability status
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 120px;
    padding-bottom: var(--space-32);
    min-height: 100vh;
  }

  .contact-grid {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 350px;
      gap: var(--space-20);
    }
  }

  /* Header */
  .page-header {
    margin-bottom: var(--space-16);
    max-width: 600px;
  }

  .page-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: var(--text-5xl);
    }
  }

  .page-intro {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
    line-height: var(--leading-relaxed);
  }

  /* Form */
  .contact-form {
    max-width: 600px;
  }

  .form-group {
    margin-bottom: var(--space-8);
  }

  .form-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-2);
  }

  .optional {
    font-weight: var(--font-normal);
    color: var(--color-gray-400);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: var(--space-4);
    font-family: inherit;
    font-size: var(--text-base);
    background-color: var(--color-gray-800);
    border: 1px solid var(--color-gray-600);
    color: var(--color-white);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-white);
    background-color: var(--color-gray-700);
  }

  .form-textarea {
    resize: vertical;
    min-height: 150px;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-8);
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    background-color: var(--color-white);
    color: var(--color-black);
    border: none;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      gap var(--transition-fast);
  }

  .form-submit:hover {
    background-color: var(--color-gray-100);
    gap: var(--space-4);
  }

  .form-submit:active {
    transform: scale(0.98);
  }

  .arrow {
    transition: transform var(--transition-fast);
  }

  .form-submit:hover .arrow {
    transform: translateX(4px);
  }

  .form-note {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-gray-400);
    padding: var(--space-4);
    background-color: var(--color-gray-800);
    border-left: 2px solid var(--color-gray-600);
  }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .contact-sidebar {
      position: sticky;
      top: 100px;
    }
  }

  .sidebar-section {
    padding: var(--space-6);
    background-color: var(--color-gray-800);
  }

  .sidebar-title {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }

  .contact-method {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .method-label {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
  }

  .method-value {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
  }

  .method-note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-gray-400);
  }

  /* Social Links */
  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background-color: var(--color-gray-700);
    border: 1px solid var(--color-gray-600);
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .social-link:hover {
    border-color: var(--color-white);
    opacity: 1;
  }

  .social-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white);
    color: var(--color-black);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .social-name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  /* Location & Availability */
  .location-text {
    font-size: var(--text-base);
    margin-bottom: 0;
  }

  .availability-text {
    font-size: var(--text-sm);
    color: var(--color-gray-300);
    line-height: var(--leading-relaxed);
  }

  .availability-note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-gray-400);
    font-style: italic;
  }
</style>
