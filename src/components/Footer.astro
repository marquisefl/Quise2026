---
/**
 * Footer Component
 *
 * Site footer with navigation, social links, and copyright.
 */

import { siteData } from "../content/site-data";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-main">
        <p class="footer-tagline">{siteData.profile.tagline}</p>
        <div class="footer-cta">
          <a href="/contact" class="cta-link">
            Get in touch
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-nav">
          <h3 class="footer-heading">Navigation</h3>
          <ul class="footer-list">
            <li><a href="/">Home</a></li>
            {siteData.navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-social">
          <h3 class="footer-heading">Connect</h3>
          <ul class="footer-list">
            {siteData.social.linkedin && (
              <li>
                <a href={siteData.social.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
              </li>
            )}
            {siteData.social.behance && (
              <li>
                <a href={siteData.social.behance} target="_blank" rel="noopener noreferrer">
                  Behance
                </a>
              </li>
            )}
            {siteData.social.dribbble && (
              <li>
                <a href={siteData.social.dribbble} target="_blank" rel="noopener noreferrer">
                  Dribbble
                </a>
              </li>
            )}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {siteData.profile.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-black);
    color: var(--color-white);
    padding: var(--space-20) 0 var(--space-8);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    gap: var(--space-16);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-20);
    }
  }

  .footer-tagline {
    font-size: var(--text-2xl);
    font-weight: var(--font-light);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-8);
    max-width: 400px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--color-white);
    border-bottom: 1px solid var(--color-white);
    padding-bottom: var(--space-1);
    transition: gap var(--transition-base);
  }

  .cta-link:hover {
    gap: var(--space-4);
    opacity: 1;
  }

  .arrow {
    transition: transform var(--transition-base);
  }

  .cta-link:hover .arrow {
    transform: translateX(4px);
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gray-400);
    margin-bottom: var(--space-6);
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-list a {
    font-size: var(--text-sm);
    color: var(--color-gray-300);
    transition: color var(--transition-fast);
  }

  .footer-list a:hover {
    color: var(--color-white);
    opacity: 1;
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-gray-800);
  }

  .copyright {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
  }
</style>
